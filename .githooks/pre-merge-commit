#!/usr/bin/env bash
# pre-merge-commit — merge-gate for the two-branch review policy.
#
#   main    : only HUMAN-reviewed merges   → merge message must carry
#             "Human-Review: approved <reviewer>"
#   ai-main : only AI-reviewed merges      → merge message must carry
#             "AI-Review: approved <agent>"
#
# The hook runs when a merge COMMIT is created, so:
#   - always merge with --no-ff (fast-forward merges bypass this hook), e.g.
#       git merge --no-ff <branch>
#   - add the trailer with:  git merge --no-ff <branch> -m "Merge branch X"
#     then the hook blocks and tells you the exact trailer to add.
# Bypassing with --no-verify defeats the gate and breaks the policy.
set -euo pipefail

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
MSG_FILE="$(git rev-parse --git-dir)/MERGE_MSG"
[ -f "$MSG_FILE" ] || MSG_FILE="$(git rev-parse --git-dir)/COMMIT_EDITMSG"
[ -f "$MSG_FILE" ] || { echo "merge-gate: no MERGE_MSG found" >&2; exit 1; }
MSG="$(cat "$MSG_FILE")"

case "$BRANCH" in
  main)
    if ! grep -Eiq "^Human-Review:[[:space:]]*approved[[:space:]]+" "$MSG_FILE"; then
      echo "✋ main is human-gated." >&2
      echo "   Merge again with an approval trailer, e.g.:" >&2
      echo "     git merge --no-ff <branch> -m 'Merge <branch>' -m 'Human-Review: approved <your-name>'" >&2
      exit 1
    fi
    ;;
  ai-main)
    if ! grep -Eiq "^AI-Review:[[:space:]]*approved[[:space:]]+" "$MSG_FILE"; then
      echo "✋ ai-main is AI-gated." >&2
      echo "   Merge again with an approval trailer, e.g.:" >&2
      echo "     git merge --no-ff <branch> -m 'Merge <branch>' -m 'AI-Review: approved <agent-name + session id>'" >&2
      exit 1
    fi
    ;;
  *)
    # feature branches and worktrees: no gate
    exit 0
    ;;
esac
exit 0
