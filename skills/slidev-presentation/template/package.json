{
  "name": "slidev-deck",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "slidev build",
    "dev": "slidev --open",
    "export": "slidev export --per-slide",
    "export:pdf": "slidev export --format pdf --per-slide",
    "export:pdf-notes": "slidev export --format pdf --per-slide --with-clicks --with-toc",
    "export:pptx": "slidev export --format pptx --per-slide",
    "export:png": "slidev export --format png --per-slide",
    "build:tikz": "node scripts/build-tikz.mjs"
  },
  "dependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/client": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0",
    "katex": "^0.18.10"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-chromium": "^1.64.0",
    "node-tikzjax": "^1.0.5"
  }
}
